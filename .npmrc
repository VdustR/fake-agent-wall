# pnpm 11 fails the install when any dependency has an unapproved build script.
# The only case here is electron-winstaller, a Windows-installer builder pulled
# in transitively by electron-builder; this app is macOS-only and never needs it,
# and pnpm-workspace.yaml records that decision. Keeping it non-fatal so scripts
# are not blocked on a build we deliberately do not run.
strictDepBuilds=false
