{
  "name": "fake-agent-wall",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "app": "pnpm build && electron .",
    "app:dev": "AGENT_WALL_DEV_URL=http://localhost:5273 electron .",
    "app:pack": "pnpm build && electron-builder --mac --dir --publish never",
    "app:dmg": "pnpm build && electron-builder --mac --publish never",
    "app:windowed": "AGENT_WALL_WINDOWED=1 AGENT_WALL_DEV_URL=http://localhost:5273 electron ."
  },
  "devDependencies": {
    "@fontsource/iosevka": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.77.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "main": "desktop/main.js",
  "description": "A fake wall of Claude Code terminals for video props. Nine sessions, all busy, none real.",
  "author": {
    "name": "ViPro",
    "url": "https://github.com/VdustR"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VdustR/fake-agent-wall.git"
  },
  "homepage": "https://vdustr.dev/fake-agent-wall/",
  "bugs": {
    "url": "https://github.com/VdustR/fake-agent-wall/issues"
  }
}
